{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": [
      "node"
    ],
    "lib": [
      "ES2022",
      "DOM"
    ],
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "shared/**/*.ts",
    "server/**/*.ts",
    "desktop-admin/src/**/*.ts",
    "desktop-admin/src/**/*.vue",
    "miniapp/src/**/*.ts",
    "miniapp/src/**/*.vue",
    "tests/**/*.ts"
  ]
}